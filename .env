# ==================== Hey MIN - ENVIRONMENT VARIABLES ====================

# App Configuration
APP_NAME=Hey MIN
APP_ENV=production
DEBUG=false
API_VERSION=v2
PORT=8000

# Security Keys
SECRET_KEY=# Render auto-generated
JWT_SECRET=# Render auto-generated
WEBHOOK_SECRET=# Render auto-generated
ENCRYPTION_KEY=# 32-character key for end-to-end encryption
CSRF_SECRET=# 64-character key

# Database
DATABASE_URL=# Render auto-generated
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# Redis
REDIS_URL=# Render auto-generated
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.mp4,.mp3,.pdf,.doc,.docx
UPLOAD_PATH=uploads
ENABLE_FILE_COMPRESSION=true

# WebRTC / Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-certificate

# AI Features
OPENAI_API_KEY=your-openai-key
ENABLE_AI_ASSISTANT=true
ENABLE_SPAM_DETECTION=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_HATE_SPEECH_FILTER=true
AI_MODEL=gpt-3.5-turbo

# Payment (Stripe)
STRIPE_API_KEY=your-stripe-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PREMIUM_PRICE_ID=price_xxxxx

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-key
EMAIL_FROM=noreply@heymin.com
EMAIL_TEMPLATE_WELCOME=welcome-template-id
EMAIL_TEMPLATE_RESET_PASSWORD=reset-password-template-id

# Push Notifications (Firebase)
FIREBASE_CREDENTIALS=firebase-credentials.json
FIREBASE_PROJECT_ID=hey-min-xxxxx

# Cloud Storage (AWS S3)
AWS_ACCESS_KEY=your-aws-key
AWS_SECRET_KEY=your-aws-secret
AWS_BUCKET_NAME=hey-min-uploads
AWS_REGION=ap-southeast-1
AWS_CLOUDFRONT_URL=https://your-cloudfront.net

# Monitoring (Sentry)
SENTRY_DSN=your-sentry-dsn
ENABLE_MONITORING=true

# Feature Toggles
ENABLE_2FA=true
ENABLE_VOICE_CALLS=true
ENABLE_VIDEO_CALLS=true
ENABLE_GROUP_CHAT=true
ENABLE_STORIES=true
ENABLE_POLLS=true
ENABLE_MESSAGE_REACTIONS=true
ENABLE_MESSAGE_EDIT=true
ENABLE_MESSAGE_DELETE=true
ENABLE_TYPING_INDICATOR=true
ENABLE_READ_RECEIPTS=true
ENABLE_SCREEN_SHARE=true
ENABLE_BLOCK_USERS=true
ENABLE_REPORT_MESSAGES=true
ENABLE_DARK_MODE=true
ENABLE_MESSAGE_SEARCH=true
ENABLE_CHAT_EXPORT=true
ENABLE_VOICE_MESSAGES=true

# Limits
MAX_GROUP_SIZE=500
MAX_FILE_SIZE_MB=10
MAX_MESSAGE_LENGTH=5000
MAX_STORY_DURATION_SECONDS=30
MAX_POLL_OPTIONS=10
MESSAGE_RETENTION_DAYS=365
STORY_RETENTION_HOURS=24

# CDN
CDN_URL=https://cdn.heymin.com
ENABLE_CDN=true

# Maintenance
MAINTENANCE_MODE=false
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# Social Login (ঐচ্ছিক)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-secret
